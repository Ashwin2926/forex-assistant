# Twelve Data API - get a free key at https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=your_key_here

# MongoDB - local instance or Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=forex_assistant

# Pairs to track (comma separated, Twelve Data format)
FOREX_PAIRS=EUR/USD,GBP/USD,USD/JPY,AUD/USD

# Environment
ENV=development

# Auth (see README "Auth") - every endpoint except / and /auth/login requires a bearer
# token. Leaving these unset fails closed (nothing can log in), not open.
# AUTH_PASSWORD_HASH is a bcrypt hash, never the plaintext -- generate one with:
#   python -c "from app.core.auth import hash_password; print(hash_password('your-password'))"
# AUTH_SECRET_KEY signs tokens -- generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_USERNAME=your_username_here
AUTH_PASSWORD_HASH=bcrypt_hash_here
AUTH_SECRET_KEY=random_32plus_byte_secret_here

# Deriv paper trading (Phase 6) - https://api.deriv.com
# 1. Create a free Deriv account, then a demo/virtual account inside it.
# 2. Register an app at api.deriv.com to get your own DERIV_APP_ID (or use the public
#    test app_id 1089 for local development).
# 3. Generate an API token under Account Settings -> API token, scoped to your DEMO
#    account. Never generate this token against a real-money account for this project.
DERIV_APP_ID=1089
DERIV_API_TOKEN=your_demo_account_token_here
